# Use: uv run python scripts/configure.py. Never commit a populated env file.
GENE_GUILD_ID=
GENE_OWNER_ID=
GENE_WORKSHOP_CHANNEL_ID=
GENE_HISTORY_CHANNEL_ID=
GENE_HIGHLIGHT_CHANNEL_ID=
GENE_MEME_SOURCE_CHANNEL_IDS=
GENE_HIGHLIGHT_THRESHOLD=5
GENE_PREFIX=!
GENE_PRESENCE=invisible
# Controller only: Gene may serve FF while Fri's GENE_GUILD_ID stays in the Lab.
GENE_RUNTIME_GUILD_ID=
GENE_SHOW_FRI=false
GENE_LAB_MODE=true
DISCORD_TOKEN=
GENE_FRI_TOKEN=
GENE_RUNTIME_TOKEN=
GENE_WORKER_TOKEN=
GENE_DEPLOY_TOKEN=
GENE_CONTROLLER_URL=http://127.0.0.1:8787
GENE_DB=.state/gene.sqlite3
# Codex uses a separate ChatGPT login, not an API key.
# Initial choice is GPT-6.1 Sol, high effort. Owner changes use /fri settings and persist in SQLite.
GENE_CODEX_MODEL=gpt-6.1-sol
GENE_REPOSITORY=HumanMint/gene
GENE_AUDIO_HOST=
GENE_AUDIO_PORT=2333
GENE_AUDIO_PASSWORD=
# Home download relay only; Hostinger runs playback and the week-long cache.
GENE_RELAY_TOKEN=
GENE_RELAY_BIND=
GENE_RELAY_PEER=
GENE_RELAY_PORT=2335
