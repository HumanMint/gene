FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /build
ADD https://github.com/Cog-Creators/Lavalink-Jars/releases/download/3.7.13%2Bred.5/Lavalink.jar ./Lavalink.jar
RUN echo '64411785e471e926a2329af600563d6fc2a33428ab2c8f6705dab358460a9bbc  Lavalink.jar' | sha256sum -c - \
    && chmod 644 Lavalink.jar \
    && jar -xf Lavalink.jar BOOT-INF/lib
COPY audio-plugin/src ./src
COPY audio-plugin/test ./test
RUN mkdir -p classes/lavalink-plugins probes \
    && javac --release 17 -cp 'BOOT-INF/lib/*' -d classes $(find src -name '*.java') \
    && printf 'path=gene.audio\nname=gene-youtube\nversion=0.2.0\n' > classes/lavalink-plugins/gene-youtube.properties \
    && jar --create --file gene-youtube.jar -C classes . \
    && javac --release 17 -cp 'BOOT-INF/lib/*:classes' -d probes test/*.java

FROM eclipse-temurin:21-jre-jammy AS node
RUN groupadd --gid 10001 gene && useradd --uid 10001 --gid 10001 --no-create-home gene
WORKDIR /audio
COPY --from=build /build/Lavalink.jar ./Lavalink.jar
COPY --from=build /build/gene-youtube.jar ./plugins/gene-youtube.jar
# Loopback decode/timing probes are available without installing a compiler on the VPS.
COPY --from=build /build/BOOT-INF/lib /probe/lib
COPY --from=build /build/probes /probe/classes
COPY --from=build /build/classes /probe/classes
USER 10001:10001
ENTRYPOINT ["java", "-Xms64m", "-Xmx384m", "-jar", "/audio/Lavalink.jar"]

FROM python:3.11-slim-bookworm AS resolver
RUN pip install --no-cache-dir uv==0.11.30
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev \
    && useradd --uid 10001 --create-home gene
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "-m", "gene.audio_resolver"]
