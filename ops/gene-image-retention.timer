[Unit]
Description=Daily conservative Gene image retention, inside the production maintenance window

[Timer]
# Production changes start only in [03:30, 07:30) America/Los_Angeles (owner policy, 2026-10-27;
# widened 2026-10-28). Late in the window, so the day's batch release has usually resumed; one still in
# flight skips the day. With its delay and its hold on batch-release.lock it ends before the close.
OnCalendar=*-*-* 07:10:00 America/Los_Angeles
RandomizedDelaySec=5min
# No catch-up: a missed window waits for the next one instead of running at another hour.
Persistent=false
Unit=gene-image-retention.service

[Install]
WantedBy=timers.target
