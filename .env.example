# Gene configuration template. Never commit a populated copy.
# Local development: `uv run python scripts/dev.py init` copies this to the git-ignored
# .env.local; paste a value from `uv run python scripts/dev.py token` into each service token
# (docs/quickstart.md).
# Production: `uv run python scripts/configure.py` writes .env.local from a bot token (docs/setup.md).
# Discord IDs are numbers: turn on Developer Mode in Discord, then right-click > Copy ID.

# --- Controller service tokens: four distinct random values, 32+ characters each ---
# Locally, `dev.py token` prints one to paste; in production, configure.py generates them.
# Each service gets only its own token.
GENE_RUNTIME_TOKEN=
GENE_WORKER_TOKEN=
GENE_DEPLOY_TOKEN=
# Fri's credential. A local Fri needs the same value: copy it into Fri's .env.local yourself
# (`dev.py fri-env` prints the other shared lines, never this one).
GENE_FRI_TOKEN=
GENE_CONTROLLER_URL=http://127.0.0.1:8787
GENE_DB=.state/gene.sqlite3

# --- Your Discord server. Fri needs the first three. ---
# The server Gene and Fri serve, and your own user ID (the owner who approves things).
GENE_GUILD_ID=
GENE_OWNER_ID=
# A text channel where Fri chats with members.
GENE_WORKSHOP_CHANNEL_ID=
# Optional: more channels where Fri may chat, comma separated.
FRI_CHANNEL_IDS=
# Optional: where Gene runs commands Fri asked for from a member's DM.
GENE_COMMAND_CHANNEL_ID=
# Optional: the channel scripts/import_history.py imports old requests from.
GENE_HISTORY_CHANNEL_ID=
# Optional, controller only: the server Red serves, when it differs from GENE_GUILD_ID.
GENE_RUNTIME_GUILD_ID=
# Optional: one extra server and channel where Fri may chat for testing.
# No jobs, owner reports or background history learning there.
FRI_TEST_GUILD_ID=
FRI_TEST_CHANNEL_ID=
# Controller-only live public web capability, using Fri's existing subscription connection.
FRI_WEB_SEARCH_ENABLED=false

# --- Red bot (optional): Gene's own Discord bot application, separate from Fri's ---
DISCORD_TOKEN=
GENE_PREFIX=!
GENE_PRESENCE=invisible
GENE_SHOW_FRI=false
GENE_LAB_MODE=true
# Meme highlights: leave the source channels empty to turn highlights off.
GENE_HIGHLIGHT_CHANNEL_ID=
GENE_MEME_SOURCE_CHANNEL_IDS=
GENE_HIGHLIGHT_THRESHOLD=5

# --- Coding worker and deployer (production only; operator runbook: docs/operations.md) ---
# Codex uses a separate ChatGPT login, not an API key.
# Initial choice is GPT-6.1 Sol, high effort. Owner changes use /fri settings and persist in SQLite.
GENE_CODEX_MODEL=gpt-6.1-sol
GENE_REPOSITORY=HumanMint/gene

# --- Music (optional): an external Red-compatible Lavalink node (operator runbook) ---
GENE_AUDIO_HOST=
GENE_AUDIO_PORT=2333
GENE_AUDIO_PASSWORD=
# Optional download relay only; the bot host runs playback and the bounded cache.
GENE_RELAY_TOKEN=
GENE_RELAY_BIND=
GENE_RELAY_PEER=
GENE_RELAY_PORT=2335
